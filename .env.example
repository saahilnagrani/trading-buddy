# Database (local dev uses docker-compose postgres; production uses Neon)
# Local:      postgresql+asyncpg://trading:trading@localhost:5432/trading_buddy
# Neon (prod): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/trading_buddy?sslmode=require
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading_buddy

# Redis (local dev uses docker-compose redis; production uses Upstash)
# Local:         redis://localhost:6379/0
# Upstash (prod): rediss://default:xxx@us1-xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Kite Connect (shared app credentials)
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_REDIRECT_URL=http://localhost:8000/api/auth/callback

# Encryption key for tokens (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY=

# VAPID keys for web push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@tradingbuddy.app

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000

# Frontend env vars (set in Render dashboard for the frontend service)
# NEXT_PUBLIC_API_URL=https://trading-buddy-api.onrender.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=  (same as VAPID_PUBLIC_KEY above)
